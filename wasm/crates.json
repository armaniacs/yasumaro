{
  "$schema": "https://example.invalid/yasumaro/wasm-crates.schema.json",
  "comment": "SSOT for the WASM crate list (PBI 2026-09-21-18). Consumers: scripts/build-wasm.mjs (npm run build:wasm), scripts/postprocess-wasm-glue.mjs, wxt.config.ts build:publicAssets, .github/workflows/ci.yml wasm gate (via scripts/wasm-crates.mjs). Adding a crate = append one entry here; no other enumeration file may list crates. publicShip=false means STAGED: built + postprocessed + src-committed, but never copied to public/wasm, never shipped via publicAssets, never cmp-gated (sentence-dedup). pkgDts/dtsCopy are null for pii-sanitizer because its src d.ts (piiSanitizerWasm.d.ts) is hand-maintained, not copied from pkg.",
  "crates": [
    {
      "name": "pii-sanitizer",
      "crateLabel": "pii-sanitizer",
      "gluePath": "wasm/pii-sanitizer/pkg/pii_sanitizer.js",
      "outPath": "src/wasm/pii-sanitizer/piiSanitizerWasm.js",
      "dtsName": "piiSanitizerWasm.d.ts",
      "wasmName": "pii_sanitizer_bg.wasm",
      "srcCopy": "src/wasm/pii-sanitizer/pii_sanitizer_bg.wasm",
      "pkgDts": null,
      "dtsCopy": null,
      "publicShip": true
    },
    {
      "name": "textrank",
      "crateLabel": "textrank",
      "gluePath": "wasm/textrank/pkg/textrank.js",
      "outPath": "src/wasm/textrank/textrankWasm.js",
      "dtsName": "textrankWasm.d.ts",
      "wasmName": "textrank_bg.wasm",
      "srcCopy": "src/wasm/textrank/textrank_bg.wasm",
      "pkgDts": "textrank.d.ts",
      "dtsCopy": "src/wasm/textrank/textrankWasm.d.ts",
      "publicShip": true
    },
    {
      "name": "sentence-dedup",
      "crateLabel": "sentence-dedup",
      "gluePath": "wasm/sentence-dedup/pkg/sentence_dedup.js",
      "outPath": "src/wasm/sentence-dedup/sentenceDedupWasm.js",
      "dtsName": "sentenceDedupWasm.d.ts",
      "wasmName": "sentence_dedup_bg.wasm",
      "srcCopy": "src/wasm/sentence-dedup/sentence_dedup_bg.wasm",
      "pkgDts": "sentence_dedup.d.ts",
      "dtsCopy": "src/wasm/sentence-dedup/sentenceDedupWasm.d.ts",
      "publicShip": false
    },
    {
      "name": "tag-cooccur",
      "crateLabel": "tag-cooccur",
      "gluePath": "wasm/tag-cooccur/pkg/tag_cooccur.js",
      "outPath": "src/wasm/tag-cooccur/tagCooccurWasm.js",
      "dtsName": "tagCooccurWasm.d.ts",
      "wasmName": "tag_cooccur_bg.wasm",
      "srcCopy": "src/wasm/tag-cooccur/tag_cooccur_bg.wasm",
      "pkgDts": "tag_cooccur.d.ts",
      "dtsCopy": "src/wasm/tag-cooccur/tagCooccurWasm.d.ts",
      "publicShip": true
    }
  ]
}
