// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`catalog view DOM goldens > gemini and openai outerHTML snapshots pin the full rendering 1`] = `"<div id="geminiSettings"><div class="form-group"><label for="geminiApiKey" data-i18n="geminiApiKey">Gemini API Key</label><input type="password" id="geminiApiKey" data-storage-key="gemini_api_key" data-i18n-input-placeholder="geminiApiKeyPlaceholder" placeholder="Paste your Gemini key here..."></div><div class="form-group"><label for="geminiModel" data-i18n="modelName">Model Name</label><input type="text" id="geminiModel" data-storage-key="gemini_model" data-i18n-input-placeholder="geminiModelPlaceholder" placeholder="gemini-3.1-flash-lite"></div><div class="form-group"><label for="geminiApiVersion" data-i18n="label_gemini_api_version">Gemini API Version</label><input type="text" id="geminiApiVersion" data-storage-key="gemini_api_version" placeholder="v1beta" aria-invalid="false" aria-describedby="geminiApiVersionNote geminiApiVersionError"><p class="help-text" data-i18n="note_gemini_api_version" id="geminiApiVersionNote">Gemini API version (v1 or v1beta).</p><div id="geminiApiVersionError" class="field-error" role="alert"></div></div></div>"`;

exports[`catalog view DOM goldens > gemini and openai outerHTML snapshots pin the full rendering 2`] = `"<div id="openaiSettings" class="openai-settings"><div class="form-group"><label for="openaiBaseUrl" data-i18n="baseUrl">Base URL</label><input type="text" id="openaiBaseUrl" data-storage-key="openai_base_url" data-i18n-input-placeholder="openaiBaseUrlPlaceholder" placeholder="https://api.openai.com/v1"></div><div class="form-group"><label for="openaiApiKey" data-i18n="aiApiKey">OpenAI API Key</label><input type="password" id="openaiApiKey" data-storage-key="openai_api_key" data-i18n-input-placeholder="openaiApiKeyPlaceholder" placeholder="sk-..."></div><div class="form-group"><label for="openaiModel" data-i18n="modelName">Model Name</label><input type="text" id="openaiModel" data-storage-key="openai_model" data-i18n-input-placeholder="openaiModelPlaceholder" placeholder="gpt-3.5-turbo"></div></div>"`;
