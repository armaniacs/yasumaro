# Pin this repository to the official npm registry regardless of any user-level
# (~/.npmrc) registry override. Project settings take precedence over user
# settings, so installs here always resolve from registry.npmjs.org.
# replace-registry-host=never (npm >= 9, default "npmjs") stops npm from
# rewriting lockfile `resolved` URLs to the configured registry, which is how a
# mirror URL gets reintroduced into this file (PBI 2026-10-18-03).
# No auth tokens or secrets here on purpose.
registry=https://registry.npmjs.org/
replace-registry-host=never
