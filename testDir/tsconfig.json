{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "types": ["chrome", "vitest/globals", "node"]
  },
  "include": [
    "../src/**/__tests__/**/*",
    "../src/**/*.d.ts",
    "../src/**/*.test.ts",
    "../src/**/*.spec.ts",
    "./__tests__/**/*.test.ts",
    "./e2e/fixtures/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist"
  ]
}